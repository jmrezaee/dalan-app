{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dalan",
  "version": "0.1.0",
  "identifier": "app.dalan.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:4000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      { "title": "Dalan", "width": 1200, "height": 780, "minWidth": 800, "minHeight": 520, "dragDropEnabled": false }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:4000 http://127.0.0.1:4001 ws://127.0.0.1:4000 ws://127.0.0.1:4001 ws://localhost:4000 ws://localhost:4001",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
