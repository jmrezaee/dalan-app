  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 10,
    "xl": 14,
    "pill": 999
  },
  "shadow": {
    "dark": {
      "card": "none",
      "pop": "0 8px 24px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.04)",
      "drag": "0 12px 32px rgba(0,0,0,.55)"
    },
    "light": {
      "card": "0 1px 2px rgba(16,24,40,.06)",
      "pop": "0 8px 24px rgba(16,24,40,.14), 0 0 0 1px rgba(16,24,40,.05)",
      "drag": "0 12px 32px rgba(16,24,40,.20)"
    }
  },
  "motion": {
    "fast": "100ms",
    "base": "160ms",
    "slow": "240ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "_note": "Respect prefers-reduced-motion: drop transforms, keep opacity fades <= 100ms."
  },
  "layout": {
    "window-min": [
      960,
      600
    ],
    "tabbar-height": 40,
    "tabbar-inset-mac": 78,
    "tab-min": 120,
    "tab-max": 220,
    "vault-nav": 220,
    "vault-nav-collapsed": 56,
    "vault-nav-collapse-below": 1100,
    "toolbar-height": 48,
    "sheet-width": 440,
    "side-panel-width": 320,
    "palette-width": 640,
    "palette-max-height": 420,
    "host-card-min": 240,
    "row-height": 44,
    "row-height-compact": 28,
    "pane-header": 28,
    "pane-min": [
      200,
      120
    ],
    "content-padding": 24
  },
  "z": {
    "base": 0,
    "sticky": 10,
    "dropdown": 40,
    "sheet": 50,
    "dialog": 60,
    "palette": 70,
    "toast": 80,
    "tooltip": 90
  }
