  "font": {
    "sans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "_note": "Both fonts are SIL OFL; bundle the woff2 files locally (offline desktop app, no CDN)."
  },
  "type": {
    "2xs": {
      "size": 11,
      "line": 14,
      "weight": 500,
      "use": "badges, kbd, tab status"
    },
    "xs": {
      "size": 12,
      "line": 16,
      "weight": 400,
      "use": "captions, table meta, hints"
    },
    "sm": {
      "size": 13,
      "line": 20,
      "weight": 400,
      "use": "default UI text, inputs, menus"
    },
    "base": {
      "size": 14,
      "line": 20,
      "weight": 500,
      "use": "card titles, emphasised rows"
    },
    "lg": {
      "size": 16,
      "line": 24,
      "weight": 600,
      "use": "sheet and dialog titles"
    },
    "xl": {
      "size": 20,
      "line": 28,
      "weight": 600,
      "use": "page titles"
    },
    "2xl": {
      "size": 24,
      "line": 32,
      "weight": 700,
      "use": "empty-state and unlock headlines"
    },
    "terminal": {
      "size": 14,
      "line": 1.2,
      "weight": 400,
      "use": "xterm default; user setting 10-24"
    }
  },
  "space": [
    0,
    2,
    4,
    6,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
