{
  "name": "dalan-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": "24.12.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.68.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cn": "^0.5.2",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/types": "^10.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "expect-webdriverio": "^8.0.0",
    "happy-dom": "^21.0.4",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "^2.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "webdriverio": "^10.2.0"
  },
  "scripts": {
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "postinstall": "node scripts/sync-tokens.mjs && nuxt prepare",
    "dev": "node scripts/sync-tokens.mjs && nuxt dev",
    "build": "node scripts/sync-tokens.mjs && nuxt generate",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit && tsc -p tests/tsconfig.json && tsc -p tests/app/tsconfig.json",
    "test": "vitest run",
    "screenshot:design": "node scripts/screenshot-design.mjs",
    "test:e2e": "playwright test --project=e2e --project=e2e-light --project=fake --project=a11y",
    "coverage": "node scripts/coverage.mjs",
    "check:features": "node scripts/features-check.mjs",
    "check:hooks": "node scripts/check-no-test-hooks.mjs",
    "walk": "node tests/walk/run.mjs",
    "walk:ci": "node tests/walk/run.mjs --headless",
    "test:visual": "scripts/in-playwright-docker.sh pnpm exec playwright test --project=visual",
    "test:visual:update": "scripts/in-playwright-docker.sh pnpm exec playwright test --project=visual --update-snapshots",
    "test:app": "node tests/app/run.mjs",
    "walk:app": "node tests/app/run.mjs --walk",
    "test:servers": "scripts/test-servers.sh",
    "test:servers:rust": "scripts/test-servers.sh up && cd src-tauri && cargo test -- --ignored"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.9"
    }
  }
}
